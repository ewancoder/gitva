{
  "compilerOptions": {
    "target": "es2022",
    "module": "node20",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "sourceMap": true,
    // `gitva/canvas` is a published entry point, so the types go out with it.
    "declaration": true,
    "outDir": "dist"
  },
  "include": ["src", "web", "test"]
}
